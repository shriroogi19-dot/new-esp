# Add these in Vercel > Project > Settings > Environment Variables (do not commit real keys)
SMS_PROVIDER=fast2sms          # console | fast2sms | twilio
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ACCESS_CODE=                   # optional secret; also type it in the website settings

# PostgreSQL connection string (Neon / Vercel Postgres / Supabase). Optional: site works without it.
DATABASE_URL=
